; SingleStepTests 680x0 (68000/v1) runner: the test itself, shared by the board
; (vectors_body.pmi) and the desktop checker (desktop/m68k_check.pb). The stream
; is what tools/vectors.py writes (groups of tests, then 'Z').
;
; The including program defines, before this file:
;   #VEC_POOL              4 KB pages in the test pool
;   RxByte()               the next byte of the stream
;   SayChar(c), Say(text), Num(v), SayHex(v, digits), Eol()
;   Same32(a, b)           1 when the low 32 bits of a and b are equal
;
; Each test maps only the pages it names (from the pool); every other page is a
; hook page, and a data access to one fails the test. After one M68kRun(1) the
; registers, SR, PC, USP, SSP, every named byte, every other byte of the mapped
; pages (they must still hold the fill, 0) and the cycle count are compared.
;
; Corpus errata: where the published expectation (generated by an emulator)
; differs from the 68000 as hardware-verified cores model it, the expectation
; is corrected to that behaviour and the test is counted as an erratum, never
; as a pass. README.md lists them with the reasons.

Global Dim VPool.l(#VEC_POOL * 1024)
Global Dim VPage.i(#VEC_POOL)
Global Dim VIn.l(20)
Global Dim VOut.l(20)
Global Dim VOutOrig.l(20)
Global Dim VRamI.l(300)          ; initial bytes (address << 8 | byte), prefetch first
Global Dim VRamF.l(600)          ; expected bytes after the instruction
Global Dim VName.a(40)
Global VUsed.i, VStray.i, VNI.i, VNF.i, VPf0.i, VPf1.i, VCycles.i, VCyc.i, VErr.i
Global VIndex.i, VGPass.i, VGFail.i, VGErr.i, VGCyc.i, VShown.i
Global VTPass.i, VTFail.i, VTErr.i, VTCyc.i, VTGroups.i

Procedure.i M68kHookRd8(a.i)
  If M68kFetching = 0
    VStray = VStray + 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i M68kHookRd16(a.i)
  If M68kFetching = 0
    VStray = VStray + 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure M68kHookWr8(a.i, v.i)
  VStray = VStray + 1
EndProcedure

Procedure M68kHookWr16(a.i, v.i)
  VStray = VStray + 1
EndProcedure

Procedure M68kResetHook()
EndProcedure

Procedure.i RxWord()
  Protected lo.i
  lo = RxByte()
  ProcedureReturn lo | (RxByte() << 8)
EndProcedure

Procedure.i RxLong()
  Protected lo.i
  lo = RxWord()
  ProcedureReturn lo | (RxWord() << 16)
EndProcedure

; Host address of guest byte a, mapping a pool page on first use; 0 = no room.
Procedure.i VHost(a.i)
  Protected g.i, k.i
  g = (a >> 12) & $FFF
  For k = 0 To VUsed - 1
    If VPage(k) = g
      ProcedureReturn @VPool(0) + (k << 12) + ((a & $FFF) ! 1)
    EndIf
  Next
  If VUsed >= #VEC_POOL
    ProcedureReturn 0
  EndIf
  k = VUsed
  VUsed = VUsed + 1
  VPage(k) = g
  M68kMapRam(g << 12, 4096, @VPool(0) + (k << 12))
  ProcedureReturn @VPool(0) + (k << 12) + ((a & $FFF) ! 1)
EndProcedure

; One failed field. what: 0-14 D0-A6, 15 USP, 16 SSP, 17 SR, 18 PC,
; 19 a byte (got / want hold the address in bits 8-31), 20 a byte outside the
; named ones, 21 an access outside the test's pages, 22 the pool is too small,
; 23 cycles.
Procedure VecFail(what.i, got.i, want.i)
  If VShown < 4
    VShown = VShown + 1
    Say("F ")
    Num(VIndex)
    Say(" op=")
    SayHex(VPf0, 4)
    Say(" what=")
    Num(what)
    Say(" got=")
    SayHex(got, 8)
    Say(" want=")
    SayHex(want, 8)
    Eol()
  EndIf
EndProcedure

Procedure VecReadTest()
  Protected k.i, n.i, mask.i, x.i, a.i, j.i, found.i
  For k = 0 To 14
    VIn(k) = RxLong()
  Next
  VIn(15) = RxLong()
  VIn(16) = RxLong()
  VIn(17) = RxWord()
  VIn(18) = RxLong()
  VPf0 = RxWord()
  VPf1 = RxWord()
  a = VIn(18) & $FFFFFF
  VRamI(0) = (a << 8) | ((VPf0 >> 8) & 255)
  VRamI(1) = (((a + 1) & $FFFFFF) << 8) | (VPf0 & 255)
  VRamI(2) = (((a + 2) & $FFFFFF) << 8) | ((VPf1 >> 8) & 255)
  VRamI(3) = (((a + 3) & $FFFFFF) << 8) | (VPf1 & 255)
  VNI = 4
  n = RxByte()
  For k = 0 To n - 1
    VRamI(VNI) = RxLong()
    VNI = VNI + 1
  Next
  mask = RxLong()
  For k = 0 To 18
    If mask & (1 << k)
      VOut(k) = RxLong()
    Else
      VOut(k) = VIn(k)
    EndIf
  Next
  For k = 0 To VNI - 1
    VRamF(k) = VRamI(k)
  Next
  VNF = VNI
  n = RxByte()
  For k = 0 To n - 1
    x = RxLong()
    found = 0
    For j = 0 To VNF - 1
      If (((VRamF(j) ! x) >> 8) & $FFFFFF) = 0
        VRamF(j) = x
        found = 1
      EndIf
    Next
    If found = 0
      VRamF(VNF) = x
      VNF = VNF + 1
    EndIf
  Next
  VCycles = RxWord()
EndProcedure

; Correct the expectation where the corpus differs from the hardware. Returns 1
; when a correction applies, 2 when the test is impossible as published.
Procedure.i VecErrata()
  Protected op.i, w.i, cnt.i, v.i, r.i
  op = VPf0
  ; ASR by more than the operand width of a negative operand: every bit
  ; shifted out is the sign, so X = C = 1 (Musashi, Moira; the corpus has 0).
  If (op & $F118) = $E000 And (op & $C0) <> $C0
    w = 8 << ((op >> 6) & 3)
    If op & $20
      cnt = VIn((op >> 9) & 7) & 63
    Else
      cnt = (op >> 9) & 7
      If cnt = 0
        cnt = 8
      EndIf
    EndIf
    r = op & 7
    v = (VIn(r) >> (w - 1)) & 1
    If cnt > w And v = 1
      VOut(17) = VOut(17) | $11
      ProcedureReturn 1
    EndIf
  EndIf
  ; DIVU / DIVS overflow: N = 1, Z = 0 (UAE, Moira); the corpus leaves N, Z.
  If (op & $F0C0) = $80C0 And (VOut(17) & 2) And VOut(18) - VIn(18) >= 2 And VOut(18) - VIn(18) <= 8
    VOut(17) = (VOut(17) & ~$C) | 8
    ProcedureReturn 1
  EndIf
  ; A byte register shift whose expected register changed above the byte.
  If (op & $F0C0) = $E000 And (op & $18) = 0
    r = op & 7
    If (VIn(r) >> 8) <> (VOut(r) >> 8)
      ProcedureReturn 2
    EndIf
  EndIf
  ProcedureReturn 0
EndProcedure

; Timing errata: ADDQ/SUBQ.L to An is 8 cycles (User's Manual table 8-4, Moira;
; the corpus has 6). DIVS whose signed quotient overflows runs the division
; first (Moira's microcode timing; the corpus stops at 16 / 18).
Procedure.i VecCycleErratum()
  Protected op.i
  op = VPf0
  If (op & $F0F8) = $5088 And VCyc = 8 And VCycles = 6
    ProcedureReturn 1
  EndIf
  If (op & $F1C0) = $81C0 And (VOut(17) & 2) And VCyc > VCycles + 60
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Run the test just read. Returns 1 pass, 0 fail, 3 erratum, 2 cycles only.
Procedure.i VecRunTest()
  Protected k.i, h.i, sr.i, bad.i, e.i, got.i, n.i
  VUsed = 0
  VStray = 0
  For k = 0 To VNF - 1
    If VHost((VRamF(k) >> 8) & $FFFFFF) = 0
      VecFail(22, VNF, #VEC_POOL)
      ProcedureReturn 0
    EndIf
  Next
  For k = 0 To VNI - 1
    PokeA(VHost((VRamI(k) >> 8) & $FFFFFF), VRamI(k) & 255)
  Next
  For k = 0 To 14
    Reg(k) = VIn(k)
  Next
  sr = VIn(17) & $FFFF
  SrHi = sr & $A700
  M68kSetCCR(sr)
  If sr & $2000
    Reg(15) = VIn(16)
    USP = VIn(15)
  Else
    Reg(15) = VIn(15)
    SSP = VIn(16)
  EndIf
  IplLine = 0
  Stopped = 0
  Halted = 0
  TracePend = 0
  AErr = 0
  M68kSetPC(VIn(18))
  VCyc = M68kRun(1)
  For k = 0 To 18
    VOutOrig(k) = VOut(k)
  Next
  e = VecErrata()
  If e = 1
    e = 0
    For k = 0 To 18
      If VOut(k) <> VOutOrig(k)
        e = 1
      EndIf
    Next
  EndIf
  bad = 0
  If e <> 2
    For k = 0 To 14
      If Same32(Reg(k), VOut(k)) = 0
        VecFail(k, Reg(k), VOut(k))
        bad = 1
      EndIf
    Next
    got = M68kGetUSP()
    If Same32(got, VOut(15)) = 0
      VecFail(15, got, VOut(15))
      bad = 1
    EndIf
    got = M68kGetSSP()
    If Same32(got, VOut(16)) = 0
      VecFail(16, got, VOut(16))
      bad = 1
    EndIf
    got = M68kGetSR()
    If got <> (VOut(17) & $FFFF)
      VecFail(17, got, VOut(17))
      bad = 1
    EndIf
    got = M68kGetPC()
    If Same32(got, VOut(18)) = 0
      VecFail(18, got, VOut(18))
      bad = 1
    EndIf
  EndIf
  ; the named bytes, then back to the fill; then nothing else may differ
  For k = 0 To VNF - 1
    h = VHost((VRamF(k) >> 8) & $FFFFFF)
    If PeekA(h) <> (VRamF(k) & 255) And e <> 2
      VecFail(19, ((VRamF(k) >> 8) << 8) | PeekA(h), VRamF(k))
      bad = 1
    EndIf
  Next
  For k = 0 To VNF - 1
    PokeA(VHost((VRamF(k) >> 8) & $FFFFFF), 0)
  Next
  For k = 0 To VUsed - 1
    n = 0
    For h = 0 To 1023
      If VPool((k << 10) + h) <> 0
        If n = 0
          VecFail(20, (VPage(k) << 12) | (h << 2), VPool((k << 10) + h))
        EndIf
        n = 1
        VPool((k << 10) + h) = 0
      EndIf
    Next
    If n
      bad = 1
    EndIf
    M68kMapHook(VPage(k) << 12, 4096)
  Next
  If VStray
    VecFail(21, VStray, 0)
    bad = 1
  EndIf
  If bad
    ProcedureReturn 0
  EndIf
  If e
    ProcedureReturn 3
  EndIf
  If VCyc <> VCycles
    If VecCycleErratum()
      ProcedureReturn 3
    EndIf
    VecFail(23, VCyc, VCycles)
    ProcedureReturn 2
  EndIf
  ProcedureReturn 1
EndProcedure

; Run one group from the stream; prints its verdict line.
Procedure VecGroup()
  Protected n.i, k.i, count.i, r.i
  n = RxByte()
  For k = 0 To n - 1
    VName(k) = RxByte()
  Next
  count = RxLong()
  VGPass = 0
  VGFail = 0
  VGErr = 0
  VGCyc = 0
  VShown = 0
  M68kMapHook(0, $1000000)
  For VIndex = 0 To count - 1
    VecReadTest()
    r = VecRunTest()
    If r = 1
      VGPass = VGPass + 1
    ElseIf r = 3
      VGErr = VGErr + 1
    ElseIf r = 2
      VGCyc = VGCyc + 1
    Else
      VGFail = VGFail + 1
    EndIf
  Next
  Say("G ")
  For k = 0 To n - 1
    SayChar(VName(k))
  Next
  Say(" pass=")
  Num(VGPass)
  Say(" fail=")
  Num(VGFail)
  Say(" cycles=")
  Num(VGCyc)
  Say(" errata=")
  Num(VGErr)
  Eol()
  VTPass = VTPass + VGPass
  VTFail = VTFail + VGFail
  VTCyc = VTCyc + VGCyc
  VTErr = VTErr + VGErr
  VTGroups = VTGroups + 1
EndProcedure

; Run groups until 'Z'. Returns 1 when every test passed or is an erratum.
Procedure.i VecStream()
  Protected c.i
  VTPass = 0
  VTFail = 0
  VTCyc = 0
  VTErr = 0
  VTGroups = 0
  c = RxByte()
  While c = 71
    VecGroup()
    c = RxByte()
  Wend
  Say("vectors groups=")
  Num(VTGroups)
  Say(" pass=")
  Num(VTPass)
  Say(" fail=")
  Num(VTFail)
  Say(" cycles=")
  Num(VTCyc)
  Say(" errata=")
  Num(VTErr)
  If VTFail = 0 And VTCyc = 0
    Say(" PASS")
    Eol()
    ProcedureReturn 1
  EndIf
  Say(" FAIL")
  Eol()
  ProcedureReturn 0
EndProcedure
