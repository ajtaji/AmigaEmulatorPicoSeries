; The beam (PAL): 227 colour clocks a line, 312 lines a frame (313 in a long
; frame). The CPU clock is two colour clocks... per colour clock: 2 CPU cycles.
#AM_CCK_LINE = 227
#AM_CPU_LINE = 454
#AM_LINES_SHORT = 312

; The output picture: hires pixels from DIW horizontal position #AM_OUT_X0
; (in lowres pixels) and lines from #AM_OUT_Y0, #AM_OUT_W x #AM_OUT_H.
#AM_OUT_X0 = $58
#AM_OUT_W = 736
#AM_OUT_Y0 = 26
#AM_OUT_H = 287

Global Dim Cust.u(256)            ; the last value written to each register
Global Dim Color.u(32)            ; COLOR00-31 (12-bit RGB)
Global DmaCon.i, IntEna.i, IntReq.i, AdkCon.i, CopCon.i, ClxCon.i, ClxDat.i
Global BplCon0.i, BplCon1.i, BplCon2.i, Bpl1Mod.i, Bpl2Mod.i
Global DiwStrt.i, DiwStop.i, DdfStrt.i, DdfStop.i
Global Dim BplPt.i(6)
Global Dim SprPt.i(8)
Global Dim SprPos.i(8)
Global Dim SprCtl.i(8)
Global Dim SprDatA.i(8)
Global Dim SprDatB.i(8)
Global Dim SprArmed.i(8)          ; 1 while the sprite's data registers show on this line
Global Dim SprState.i(8)          ; DMA: 0 fetch POS/CTL next, 1 waiting for VSTART, 2 showing, 3 done
Global Cop1Lc.i, Cop2Lc.i, CopPc.i
Global SerPer.i, PotGo.i, SerDatR.i
Global LongFrame.i, LaceLong.i

; Time. FrameCyc counts CPU cycles from the start of the frame; LineCyc0 is
; the CPU cycle at which the current line began; VPos is the line number.
Global FrameCyc.i, LineCyc0.i, VPos.i, LinesThisFrame.i, FrameCount.i
Global SliceStart.i, ChipHost.i, ChipMask.i
Global AmigaETotal.i, AmigaEFrac.i

Declare AmigaSetIpl()
Declare DispCatchUp(hpos.i)
Declare BlitStart()
Declare BlitFinish()
Declare.i BlitBusy()
Declare CopperJump(lc.i)
Declare DiskLenWrite(v.i)
Declare AudioWrite(reg.i, v.i)
Declare.i AmigaNowCyc()

; The colour clock within the current line, from the CPU's current time.
Procedure.i AmigaHPos()
  Protected h.i
  h = (AmigaNowCyc() - LineCyc0) >> 1
  If h > #AM_CCK_LINE - 1
    h = #AM_CCK_LINE - 1
  EndIf
  If h < 0
    h = 0
  EndIf
  ProcedureReturn h
EndProcedure

; A 16-bit value sign-extended, the same on a 32-bit and a 64-bit host.
Procedure.i Sx16(v.i)
  ProcedureReturn ((v & $FFFF) ! $8000) - $8000
EndProcedure

; Clear bytes (a multiple of 4) at a 4-byte aligned host address.
Procedure MemClear(addr.i, bytes.i)
  Protected k.i
  k = 0
  While k < bytes
    PokeL(addr + k, 0)
    k = k + 4
  Wend
EndProcedure

; A word of chip RAM (DMA side): addr is masked to the chip RAM.
Procedure.i ChipRd(addr.i)
  ProcedureReturn PeekU(ChipHost + (addr & ChipMask & ~1))
EndProcedure

Procedure ChipWr(addr.i, v.i)
  PokeU(ChipHost + (addr & ChipMask & ~1), v)
EndProcedure
