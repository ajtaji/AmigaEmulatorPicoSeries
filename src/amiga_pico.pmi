; The Amiga 500 on an RP2350 board with 8 MB of QSPI PSRAM (Pimoroni Pico Plus
; 2 W, Adafruit Feather RP2350 HSTX). The board file names the PSRAM's chip
; select (#PM_PSRAM_CS); the wrappers (amiga.picoplus2w, amiga.feather2350)
; set the clock and include this file.
;
; Memory: the 68000 core and the chip emulation run from SRAM (the whole
; program, EnableRunFromRAM in the wrapper). Chip RAM (512 KB) and slow RAM
; (512 KB) are in the PSRAM through its cached window. The Kickstart and the
; disk in DF0 come from the flash regions below, written with
;   PureMetalForge.exe --storage-write <file> --offset <n> --port <COMn>
; from the files tools/pico_media.py makes: the Kickstart in host word order,
; 512 KB (a 256 KB ROM twice), and the .ADF as it is. The disk is copied to
; the PSRAM at start (writes stay there until power-off).
;
; Headless: what the Amiga sends on its serial port, and the machine's state,
; come out on USB serial. Commands on USB serial: 's' sends the next picture
; (hex, one line per Amiga line), 'r' resets, 'k' + two hex digits presses
; and releases a key (Amiga raw code), 'm' + dx dy (signed bytes, hex)
; moves the mouse.
EnableExplicit

; #KICK_OFFSET and #DF0_OFFSET come from the board's wrapper (clear of what else lives in its flash)
FlashRegion "kickstart", #KICK_OFFSET, $80000, "raw"
FlashRegion "df0", #DF0_OFFSET, $DC000, "raw"

#PS_CHIP = $000000
#PS_SLOW = $080000
#PS_DF0 = $100000
; Paula's ring: mono at 48 kHz, the rate the Bluetooth link plays (85 ms); read in
; place by BtAudioSource on the Pico Plus 2 W, unused on a board with no radio.
#AUD_RING = 4096
#AUD_RATE = 48000
#AUD_MONO = 1
; where the time goes: #AM_PROFILE = 1 in the wrapper (src/amiga_profile.feather2350) times each
; part of the line with the M33's cycle counter (DWT CYCCNT, enabled in Main); 'p' prints it.
; It costs about 1 ms a frame, so the normal builds leave it out.
#AM_BLIT_ASM = 1      ; area blits without fill: src/blit_fast.pmi
#AM_AUDIO_ASM = 1     ; Paula's line of mono audio: src/audio_fast.pmi (#AUD_RING 4096)
Macro AmClock()
  PeekL($E0001004)
EndMacro

XIncludeFile "m68k.pico2"
XIncludeFile "../amiga/chipset.pmi"
XIncludeFile "../amiga/cia.pmi"
XIncludeFile "../amiga/copper.pmi"
XIncludeFile "../amiga/denise.pmi"
XIncludeFile "../amiga/blitter.pmi"
XIncludeFile "blit_fast.pmi"
XIncludeFile "../amiga/paula.pmi"
XIncludeFile "audio_fast.pmi"
XIncludeFile "../amiga/input.pmi"
XIncludeFile "../amiga/machine.pmi"
XIncludeFile "io.pmi"
CompilerIf #AMIGA_AUDIO = 1
  XIncludeFile "audio_bt.pmi"
CompilerEndIf

Global Unpaced.i                  ; 'f': run as fast as the board can (for measuring headroom)
Global ShotWant.i, ShotNow.i, FrameSum.i, LastFrameSum.i, DumpAt.i, ProfFrom.i = -1, SumEvery.i
Global Dim SerBuf.a(256)
; the low #CHIP_SRAM_KB of chip RAM lives in SRAM (from the board's wrapper): the
; emulated DMA streams through the PSRAM's 16 KB cache and evicts the CPU's work
; there, so what a program keeps low runs at SRAM speed
CompilerIf #CHIP_SRAM_KB > 0
  Global Dim ChipSram.l(#CHIP_SRAM_KB * 256)
CompilerEndIf
Global SerLen.i

Procedure HexDigit(v.i)
  v = v & 15
  If v < 10
    UsbSerialWrite(48 + v)
  Else
    UsbSerialWrite(55 + v)
  EndIf
EndProcedure

; A picture line: into the frame's checksum, and to USB while a picture is asked for.
Procedure AmigaLineDone(y.i)
  Protected x.i, c.i
  For x = 0 To #AM_OUT_W - 1 Step 8
    FrameSum = ((FrameSum << 1) | ((FrameSum >> 31) & 1)) ! LineBuf(x)
  Next
  If ShotNow
    UsbSerialWrite(76)
    For x = 0 To #AM_OUT_W - 1 Step 2
      c = LineBuf(x)
      HexDigit(c >> 8)
      HexDigit(c >> 4)
      HexDigit(c)
    Next
    Eol()
  EndIf
EndProcedure

Procedure AmigaSerial(byte.i)
  If byte = 10 Or SerLen >= 250
    Say("S:")
    For byte = 0 To SerLen - 1
      UsbSerialWrite(SerBuf(byte))
    Next
    Eol()
    SerLen = 0
    ProcedureReturn
  EndIf
  If byte >= 32
    SerBuf(SerLen) = byte
    SerLen = SerLen + 1
  EndIf
EndProcedure

Procedure.i HexIn(c.i)
  If c >= 48 And c <= 57
    ProcedureReturn c - 48
  EndIf
  If c >= 65 And c <= 70
    ProcedureReturn c - 55
  EndIf
  If c >= 97 And c <= 102
    ProcedureReturn c - 87
  EndIf
  ProcedureReturn 0
EndProcedure

; Chip RAM as the 68000 sees it (big-endian), 64 bytes a line: "C" + hex, then "CEND".
Procedure DumpChip()
  Protected a.i, b.i, v.i
  Say("CHIP frame=")
  Num(FrameCount)
  Eol()
  For a = 0 To $7FFC0 Step 64
    UsbSerialWrite(67)
    For b = 0 To 63
      v = PeekA(ChipBase((a + b) >> 16) + ((a + b) ! 1))
      HexDigit(v >> 4)
      HexDigit(v)
    Next
    Eol()
    UsbSerialTask()
    SafetyPet()
  Next
  Say("CEND")
  Eol()
  ; Paula's ring as it stands (mono samples, oldest first after AudWr)
  Say("AUD wr=")
  Num(AudWr)
  Eol()
  For a = 0 To #AUD_RING - 1 Step 32
    UsbSerialWrite(65)
    For b = 0 To 31
      v = AudRing(a + b) & $FFFF
      HexDigit(v >> 12)
      HexDigit(v >> 8)
      HexDigit(v >> 4)
      HexDigit(v)
    Next
    Eol()
    UsbSerialTask()
    SafetyPet()
  Next
  Say("AEND")
  Eol()
EndProcedure

CompilerIf #AM_PROFILE = 1
; microseconds per frame in each part of the line (AmigaRunLine), over 50 frames
Procedure ProfReport()
  Protected k.i, tot.i
  Say("PROF us/frame: disp0 cpu copper blitend disp1 audio disk+kbd cia+frame | blit catchup =")
  tot = 0
  For k = 0 To 7
    Say(" ")
    Num(AmProf(k) / (50 * (#CLOCK_KHZ / 1000)))
    tot = tot + AmProf(k) / (50 * (#CLOCK_KHZ / 1000))
  Next
  Say(" |")
  For k = 8 To 9
    Say(" ")
    Num(AmProf(k) / (50 * (#CLOCK_KHZ / 1000)))
  Next
  Say(" | M68kRun calls/frame ")
  Num(AmProf(10) / 50)
  Say(" | fast hit/frame ")
  Num(M68kFastHit / 50)
  Say(" miss ")
  Num(M68kFastMiss / 50)
  Say(" | blits/frame ")
  Num(AmProf(16) / 50)
  Say(" words ")
  Num(AmProf(15) / 50)
  Say(" | chip reg reads us ")
  Num(AmProf(11) / (50 * (#CLOCK_KHZ / 1000)))
  Say(" n ")
  Num(AmProf(13) / 50)
  Say(" writes us ")
  Num(AmProf(12) / (50 * (#CLOCK_KHZ / 1000)))
  Say(" n ")
  Num(AmProf(14) / 50)
  Say(" total ")
  Num(tot)
  Eol()
EndProcedure
CompilerEndIf

Procedure.i RxWait()
  Protected c.i
  c = UsbSerialRead()
  While c < 0
    UsbSerialTask()
    SafetyPet()
    c = UsbSerialRead()
  Wend
  ProcedureReturn c
EndProcedure

Procedure Commands()
  Protected c.i, v.i, dx.i, dy.i
  c = UsbSerialRead()
  While c >= 0
    If c = 115
      ShotWant = 1
    ElseIf c = 114
      AmigaReset()
      Say("reset")
      Eol()
    ElseIf c = 107
      v = (HexIn(RxWait()) << 4) | HexIn(RxWait())
      AmigaKey(v, 0)
      AmigaKey(v, 1)
    ElseIf c = 100
      ; d + four hex digits: dump chip RAM when that frame has run (to diff against amiga_cli --dump-chip)
      DumpAt = (HexIn(RxWait()) << 12) | (HexIn(RxWait()) << 8) | (HexIn(RxWait()) << 4) | HexIn(RxWait())
    ElseIf c = 102
      ; f: paced to PAL (the default) / as fast as it goes
      Unpaced = 1 - Unpaced
    ElseIf c = 99
      ; c: the picture checksum one frame in ten on (costs the drawing of that frame) / off
      SumEvery = 1 - SumEvery
    ElseIf c = 112
      ; p: time per part of the line over the next 50 frames
      ProfFrom = -2
    ElseIf c = 109
      dx = (HexIn(RxWait()) << 4) | HexIn(RxWait())
      dy = (HexIn(RxWait()) << 4) | HexIn(RxWait())
      AmigaMouse(((dx ! $80) - $80), ((dy ! $80) - $80), 0, 0)
    EndIf
    c = UsbSerialRead()
  Wend
EndProcedure

Procedure Main()
  Protected n.i, k.i, t0.i, t1.i, frames.i, cyc0.i, us.i, w.i, pace.i, fs.i, fw.i, fmax.i, late.i, lateAll.i
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  PokeL($E000EDFC, PeekL($E000EDFC) | $01000000)    ; DEMCR.TRCENA
  PokeL($E0001004, 0)
  PokeL($E0001000, PeekL($E0001000) | 1)            ; DWT CYCCNT on
  TimerInit()
  UsbSerialInit()
  WaitHost()
  Say("Amiga 500 on RP2350, clk_sys kHz=")
  Num(ClockSysKhz())
  Eol()
  n = PsramBegin(#PM_PSRAM_CS)
  Say("PSRAM bytes=")
  Num(n)
  Say(" error=")
  Num(PsramError())
  Eol()
  If n < $200000
    Say("no PSRAM: the chip RAM has nowhere to go")
    Eol()
    Repeat
      UsbSerialTask()
      SafetyPet()
    ForEver
  EndIf
  ChipMask = $7FFFF
  CompilerIf #CHIP_SRAM_KB > 0
    ChipSetHost(@ChipSram(0), #CHIP_SRAM_KB * 1024, #PSRAM_BASE + #PS_CHIP + #CHIP_SRAM_KB * 1024)
  CompilerElse
    ChipSetHost(#PSRAM_BASE + #PS_CHIP, 0, #PSRAM_BASE + #PS_CHIP)
  CompilerEndIf
  AmigaSlowHost = #PSRAM_BASE + #PS_SLOW
  AmigaSlowBytes = $80000
  For k = 0 To $FFFFC Step 4
    PokeL(#PSRAM_BASE + k, 0)
  Next
  AmigaRomHost = $10000000 + #KICK_OFFSET
  AmigaRomBytes = $80000
  w = PeekL(AmigaRomHost)
  If w = -1
    Say("the kickstart region is empty: write it with --storage-write (tools/pico_media.py makes the file)")
    Eol()
  EndIf
  ; the disk: flash -> PSRAM, so it can be written
  If PeekA($10000000 + #DF0_OFFSET) = $44
    t0 = Micros()
    For k = 0 To #ADF_BYTES - 4 Step 4
      PokeL(#PSRAM_BASE_UNCACHED + #PS_DF0 + k, PeekL($10000000 + #DF0_OFFSET + k))
    Next
    Say("DF0: a disk, copied in ")
    Num((Micros() - t0) / 1000)
    Say(" ms")
    Eol()
  EndIf
  AmigaReset()
  If PeekA($10000000 + #DF0_OFFSET) = $44
    DriveInsert(0, #PSRAM_BASE + #PS_DF0, 0)
  EndIf
  ; what the CPU starts from: the ROM's first words as the core sees them, and the reset PC
  Say("rom ")
  Hex(PeekL(AmigaRomHost), 8)
  Say(" ")
  Hex(PeekL(AmigaRomHost + 4), 8)
  Say(" pc=")
  Hex(M68kGetPC(), 8)
  Say(" ssp=")
  Hex(M68kGetSSP(), 8)
  Eol()
  CompilerIf #AMIGA_AUDIO = 1
    If AudioBegin(?Speaker)
      If LaunchCore1()
        PokeL(@Core1Go, 1)
        Say("Bluetooth: playing")
      Else
        Say("Bluetooth: core 1 did not start; running silent")
        AudioRunning = 0
      EndIf
      Eol()
    EndIf
  CompilerEndIf
  Say("READY")
  Eol()
  t0 = Micros()
  cyc0 = AmigaCpuCycles
  pace = t0
  Repeat
    If ShotWant And VPos = 0
      ShotWant = 0
      ShotNow = 1
      Say("SHOT")
      Eol()
    EndIf
    FrameSum = 0
    ; the picture is drawn only for a picture asked for, and with c one frame in ten (the checksum)
    DispDrawOn = Bool(ShotNow Or (SumEvery > 0 And (FrameCount % 10) = 0))
    fs = Micros()
    AmigaRunFrame()
    ; the frame's own work, in microseconds: PAL gives it 20,000
    fw = Micros() - fs
    If fw > fmax
      fmax = fw
    EndIf
    If fw > 20000
      late = late + 1
      lateAll = lateAll + 1
    EndIf
    LastFrameSum = FrameSum
    If ShotNow
      ShotNow = 0
      Say("END")
      Eol()
    EndIf
    CompilerIf #AM_PROFILE = 1
      If ProfFrom = -2
        For k = 0 To 16
          AmProf(k) = 0
        Next
        M68kFastHit = 0
        M68kFastMiss = 0
        ProfFrom = FrameCount
      ElseIf ProfFrom >= 0 And FrameCount - ProfFrom >= 50
        ProfReport()
        ProfFrom = -1
      EndIf
    CompilerEndIf
    If DumpAt > 0 And FrameCount = DumpAt
      DumpChip()
      DumpAt = 0
    EndIf
    frames = frames + 1
    ; the pace of a real A500: PAL's 50 frames a second ('f' turns it off to measure headroom)
    If Unpaced = 0
      pace = pace + 20000
      While Micros() - pace < 0
        UsbSerialTask()
        SafetyPet()
      Wend
      If Micros() - pace > 100000
        pace = Micros()     ; behind (a heavy frame): do not race to catch up
      EndIf
    Else
      pace = Micros()
    EndIf
    UsbSerialTask()
    SafetyPet()
    Commands()
    t1 = Micros()
    If t1 - t0 >= 2000000
      us = t1 - t0
      Say("frames/s x10=")
      Num(Rate(frames * 10, us))
      Say(" cpu kcycles/s=")
      Num(Rate(AmigaCpuCycles - cyc0, us) / 1000)
      Say(" pc=")
      Hex(M68kGetPC(), 6)
      Say(" frame=")
      Num(FrameCount)
      Say(" sum=")
      Hex(LastFrameSum, 8)
      Say(" df0 track=")
      Num(DrvTrack(0))
      Say(" motor=")
      Num(DrvMotor(0))
      Say(" work max us=")
      Num(fmax)
      Say(" late=")
      Num(late)
      Say(" late total=")
      Num(lateAll)
      fmax = 0
      late = 0
      CompilerIf #AMIGA_AUDIO = 1
        If AudioRunning
          Say(" bt live=")
          Num(BtAudioLive())
          Say(" packets=")
          Num(BtAudioPackets())
          Say(" underruns=")
          Num(BtAudioUnderruns())
        EndIf
      CompilerEndIf
      Eol()
      frames = 0
      cyc0 = AmigaCpuCycles
      t0 = Micros()
    EndIf
  ForEver
EndProcedure
