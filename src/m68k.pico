MOVEM136:
  vs = PeekU(PIP + 2)
  xo = 4
  If (op & $38) = $20
  Goto PRE137
  EndIf
  If (op & $38) = $18
  Goto IllegalOp
  EndIf
  EaRet = ?C138
  Goto Ctl(op & 63)
C138:
  If (op & 63) >= $3A
  Goto IllegalOp
  EndIf
  If (ea & 1) And vs <> 0
    AeAddr = ea
    AeBack = 4 - EaCtlCyc(256 + (op & 63))
    AeCode = 0
  Goto AddrErr
  EndIf
  For rg = 0 To 15
    If vs & (1 << rg)
      vr = Reg(rg)
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
      ea = ea + 2
  CLeft = CLeft - 4
    EndIf
  Next
  CLeft = CLeft - (EaCtlCyc(256 + (op & 63)))
  PIP = PIP + xo
  NextOp()
