  t = PageR((ea >> 12) & $FFF)
  If t <> 0
    y = PeekA(t + ((ea & $FFFFFF) ! 1))
  Else
    y = M68kRd8(ea)
  EndIf
  PokeU(@Reg(0) + ((rg) << 2), (x << 8) | y)
  CLeft = CLeft - 16
  PIP = PIP + xo
  NextOp()

BCHGD:
