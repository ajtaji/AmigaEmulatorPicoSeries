  EndIf
  If rg <= 16
    vr = (vd << rg) & $FFFF
    FC = ((vd >> (16 - rg)) & 1) << 31
  Else
    vr = 0
    FC = 0
  EndIf
  FX = FC
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D352
Z351:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D352:
  Goto O346
T344:
  If rg = 0
  Goto Z353
  EndIf
  x = rg
  While x > 16
    x = x - 17
  Wend
  vr = vd
  y = ((FX >> 31) & 1)
  While x > 0
    u = ((vr >> 15)) & 1
    vr = ((vr << 1) | y) & $FFFF
    y = u
    x = x - 1
  Wend
  FX = y << 31
  FC = FX
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D354
Z353:
  vr = vd
  FV = 0
  FC = FX
  FZ = (vr) << 16
  FN = FZ
D354:
  Goto O346
O346:
  PokeU(@Reg(0) + ((op & 7) << 2), vr)
  CLeft = CLeft - (6 + (rg << 1))
  PIP = PIP + xo
  NextOp()

ShRL:
  op = PeekU(PIP)
  xo = 2
  x = (op >> 9) & 7
  If op & $20
    x = Reg(x) & 63
  ElseIf x = 0
    x = 8
  EndIf
  rg = x
  vd = Reg(op & 7)
  y = (op >> 3) & 3
  If y = 0
  Goto T355
  EndIf
  If y = 1
  Goto T356
  EndIf
  If y = 2
  Goto T357
  EndIf
T358:
  If rg = 0
  Goto Z360
  EndIf
  x = rg & 31
  vr = (vd << x) | ((vd >> (32 - x)) & ~(($80000000 >> (32 - x)) << 1))
  If x = 0
    vr = vd
  EndIf
  FC = (vr & 1) << 31
  FV = 0
  FZ = vr
  FN = FZ
  Goto D361
Z360:
  vr = vd
  FV = 0
  FC = 0
  FZ = vr
  FN = FZ
D361:
  Goto O359
T355:
  If rg = 0
  Goto Z362
  EndIf
  If rg < 32
    vr = vd << rg
    FC = ((vd >> (32 - rg)) & 1) << 31
    x = vd >> (31 - rg)
    If x = 0 Or x = -1
      FV = 0
    Else
      FV = $80000000
    EndIf
  Else
    vr = 0
    If rg = 32
      FC = (vd & 1) << 31
    Else
      FC = 0
    EndIf
    If vd <> 0
      FV = $80000000
    Else
      FV = 0
    EndIf
  EndIf
  FX = FC
  FZ = vr
  FN = FZ
  Goto D363
Z362:
  vr = vd
  FV = 0
  FC = 0
  FZ = vr
  FN = FZ
D363:
  Goto O359
T356:
  If rg = 0
  Goto Z364
  EndIf
  If rg <= 32
    vr = vd << rg
    FC = ((vd >> (32 - rg)) & 1) << 31
    If rg = 32
      vr = 0
      FC = (vd & 1) << 31
    EndIf
  Else
    vr = 0
    FC = 0
  EndIf
  FX = FC
  FV = 0
  FZ = vr
  FN = FZ
  Goto D365
Z364:
  vr = vd
  FV = 0
  FC = 0
  FZ = vr
  FN = FZ
D365:
  Goto O359
T357:
  If rg = 0
  Goto Z366
  EndIf
  x = rg
  While x > 32
    x = x - 33
  Wend
  vr = vd
  y = ((FX >> 31) & 1)
  While x > 0
    u = (((vr >> 31) & ~(($80000000 >> 31) << 1))) & 1
    vr = (vr << 1) | y
    y = u
    x = x - 1
  Wend
  FX = y << 31
  FC = FX
  FV = 0
  FZ = vr
  FN = FZ
  Goto D367
Z366:
  vr = vd
  FV = 0
  FC = FX
  FZ = vr
  FN = FZ
D367:
  Goto O359
O359:
  Reg(op & 7) = vr
  CLeft = CLeft - (8 + (rg << 1))
  PIP = PIP + xo
  NextOp()

ShM0L:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A368
  Goto AltW(op & 63)
A368:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z369
  EndIf
  If rg < 16
    vr = (((vd) << 16) >> 16 >> rg) & $FFFF
    FC = ((vd >> (rg - 1)) & 1) << 31
  Else
    If vd & $8000
      vr = $FFFF
      FC = $80000000
    Else
      vr = 0
      FC = 0
    EndIf
  EndIf
  FX = FC
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D370
Z369:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D370:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM0R:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A371
  Goto AltW(op & 63)
A371:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z372
  EndIf
  If rg < 16
    vr = (vd << rg) & $FFFF
    FC = ((vd >> (16 - rg)) & 1) << 31
    x = ((vd) << 16) >> 16 >> (15 - rg)
    If x = 0 Or x = -1
      FV = 0
    Else
      FV = $80000000
    EndIf
  Else
    vr = 0
    If rg = 16
      FC = (vd & 1) << 31
    Else
      FC = 0
    EndIf
    If vd <> 0
      FV = $80000000
    Else
      FV = 0
    EndIf
  EndIf
  FX = FC
  FZ = (vr) << 16
  FN = FZ
  Goto D373
Z372:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D373:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM1L:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A374
  Goto AltW(op & 63)
A374:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z375
  EndIf
  If rg <= 16
    vr = (vd >> rg)
    FC = ((vd >> (rg - 1)) & 1) << 31
  Else
    vr = 0
    FC = 0
  EndIf
  FX = FC
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D376
Z375:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D376:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM1R:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A377
  Goto AltW(op & 63)
A377:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z378
  EndIf
  If rg <= 16
    vr = (vd << rg) & $FFFF
    FC = ((vd >> (16 - rg)) & 1) << 31
  Else
    vr = 0
    FC = 0
  EndIf
  FX = FC
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D379
Z378:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D379:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM2L:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A380
  Goto AltW(op & 63)
A380:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z381
  EndIf
  x = rg
  While x > 16
    x = x - 17
  Wend
  vr = vd
  y = ((FX >> 31) & 1)
  While x > 0
    u = vr & 1
    vr = (vr >> 1) | (y << 15)
    y = u
    x = x - 1
  Wend
  FX = y << 31
  FC = FX
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D382
Z381:
  vr = vd
  FV = 0
  FC = FX
  FZ = (vr) << 16
  FN = FZ
D382:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM2R:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A383
  Goto AltW(op & 63)
A383:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z384
  EndIf
  x = rg
  While x > 16
    x = x - 17
  Wend
  vr = vd
  y = ((FX >> 31) & 1)
  While x > 0
    u = ((vr >> 15)) & 1
    vr = ((vr << 1) | y) & $FFFF
    y = u
    x = x - 1
  Wend
  FX = y << 31
  FC = FX
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D385
Z384:
  vr = vd
  FV = 0
  FC = FX
  FZ = (vr) << 16
  FN = FZ
D385:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM3L:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A386
  Goto AltW(op & 63)
A386:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z387
  EndIf
  x = rg & 15
  vr = ((vd >> x) | (vd << (16 - x))) & $FFFF
  If x = 0
    vr = vd
  EndIf
  FC = ((vr >> 15) & 1) << 31
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D388
Z387:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D388:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

ShM3R:
  op = PeekU(PIP)
  xo = 2
  If op & $800
  Goto IllegalOp
  EndIf
  EaRet = ?A389
  Goto AltW(op & 63)
A389:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vd = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vd = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  rg = 1
  If rg = 0
  Goto Z390
  EndIf
  x = rg & 15
  vr = ((vd << x) | (vd >> (16 - x))) & $FFFF
  If x = 0
    vr = vd
  EndIf
  FC = (vr & 1) << 31
  FV = 0
  FZ = (vr) << 16
  FN = FZ
  Goto D391
Z390:
  vr = vd
  FV = 0
  FC = 0
  FZ = (vr) << 16
  FN = FZ
D391:
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    PokeU(t + (ea & $FFFFFF), vr)
  Else
    AeAddr = ea
    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()

IllegalOp:
  op = PeekU(PIP)
  ExcPc = (PIP - PBase)
  ExcVec = 4
  ExcCyc = 34
  Goto TakeExc
LineA:
  ExcPc = (PIP - PBase)
  ExcVec = 10
  ExcCyc = 34
  Goto TakeExc
LineF:
  ExcPc = (PIP - PBase)
  ExcVec = 11
  ExcCyc = 34
  Goto TakeExc
PrivViol:
  ExcPc = (PIP - PBase)
  ExcVec = 8
  ExcCyc = 34
  Goto TakeExc
TakeExc:
  M68kException(ExcVec, ExcPc)
  CLeft = CLeft - ExcCyc
  Goto Resync
; A data access at AeAddr faulted (AeCode: $10 read, 0 write).
AddrErr:
  AePc = PIP - PBase + xo - 2
AddrErrP:
  If SrHi & $2000
    x = 5
  Else
    x = 1
  EndIf
  M68kAddressError(AeAddr, AePc, (op << 16) | (op & $FFE0) | AeCode | x)
  CLeft = CLeft - 50 + AeBack
  Goto Resync
; A jump to an odd address: the fetch at AeAddr faults, AePc is pushed.
JumpErr:
  If SrHi & $2000
    x = $1E
  Else
    x = $1A
  EndIf
  M68kAddressError(AeAddr, AePc, (op << 16) | (op & $FFE0) | x)
  CLeft = CLeft - 50 + AeBack
  Goto Resync

Done:
  M68kCycles = M68kCycles + Budget - CLeft
  ProcedureReturn Budget - CLeft
EndProcedure
