  FV = ((vs ! vr) & (vd ! vr)) << 24
  FC = ((vs & vd) | ((vs | vd) & ~vr)) << 24
  FX = FC
  t = PageW((ea >> 12) & $FFF)
  If t <> 0
    PokeA(t + ((ea & $FFFFFF) ! 1), vr)
  Else
