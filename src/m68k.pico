  vr = ((PeekA(@Reg(0) + ((op & 7) << 2))) << 24) >> 24
  PokeU(@Reg(0) + ((op & 7) << 2), vr)
  FZ = (vr) << 16
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 4
