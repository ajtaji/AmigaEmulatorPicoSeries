    M68kWr16(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()
EORISR:
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  vs = PeekU(PIP + 2)
  x = M68kGetSR()
  x = x ! vs
  M68kSetSR(x)
  xo = 4
  CLeft = CLeft - 20
  PIP = PIP + xo
  NextOp()

EORIL:
  op = PeekU(PIP)
  xo = 2
  vs = (PeekU(PIP + 2) << 16) | PeekU(PIP + 4)
  xo = 6
  If (op & $38) <> 0
  Goto M76
  EndIf
  vd = Reg(op & 7)
  vr = vd ! vs
  FZ = vr
  FN = FZ
  FV = 0
  FC = 0
  Reg(op & 7) = vr
  CLeft = CLeft - 16
  PIP = PIP + xo
  NextOp()
M76:
  CLeft = CLeft - 8
  EaRet = ?A77
  Goto AltL(op & 63)
A77:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    vd = (PeekU(u) << 16) | PeekU(u + 2)
  Else
    AeAddr = ea
    vd = M68kRd32(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  vr = vd ! vs
  FZ = vr
  FN = FZ
  FV = 0
  FC = 0
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    PokeU(u, vr >> 16)
    PokeU(u + 2, vr)
  Else
    AeAddr = ea
    M68kWr32(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 12
  PIP = PIP + xo
  NextOp()

CMPIB:
