    AeAddr = vd
    AePc = vd - 4
    AeBack = 8 - (EaCtlCyc(128 + (op & 63)))
  Goto JumpErr
  EndIf
  PIP = PBase + vd
  If PIP < PStart
    PEnd = 0
  EndIf
  CLeft = CLeft - (EaCtlCyc(128 + (op & 63)))
  NextOp()

CHK:
  op = PeekU(PIP)
  xo = 2
  If (op & $38) = 0
    vs = PeekU(@Reg(0) + ((op & 7) << 2))
    Goto S155
  EndIf
  If (op & $38) = 8
    Goto IllegalOp
  EndIf
  EaRet = ?S155
  Goto SrcW(op & 63)
S155:
  vd = ((PeekU(@Reg(0) + (((op >> 9) & 7) << 2))) << 16) >> 16
  vs = ((vs) << 16) >> 16
  FZ = vd & $FFFF
  FV = 0
  FC = 0
  If vd < 0
    FN = $80000000
    If vd > vs
  ExcPc = (PIP - PBase + xo)
  ExcVec = 6
  ExcCyc = 38
  Goto TakeExc
    EndIf
  ExcPc = (PIP - PBase + xo)
  ExcVec = 6
  ExcCyc = 40
  Goto TakeExc
  EndIf
  If vd > vs
    FN = 0
  ExcPc = (PIP - PBase + xo)
  ExcVec = 6
  ExcCyc = 38
  Goto TakeExc
  EndIf
  CLeft = CLeft - 10
  PIP = PIP + xo
  NextOp()

LEA:
  op = PeekU(PIP)
  xo = 2
  EaRet = ?C156
  Goto Ctl(op & 63)
C156:
  Reg(8 + ((op >> 9) & 7)) = ea
  CLeft = CLeft - (EaCtlCyc(0 + (op & 63)))
  PIP = PIP + xo
  NextOp()

ADDQB:
  op = PeekU(PIP)
  xo = 2
  vs = (op >> 9) & 7
  If vs = 0
    vs = 8
  EndIf
  If (op & $38) <> 0
    If (op & $38) = 8
  Goto AN158
    EndIf
  Goto M157
  EndIf
  vd = PeekA(@Reg(0) + ((op & 7) << 2))
  vr = vd + vs
  FZ = (vr) << 24
  FN = FZ
  FV = ((vs ! vr) & (vd ! vr)) << 24
  FC = ((vs & vd) | ((vs | vd) & ~vr)) << 24
  FX = FC
  PokeA(@Reg(0) + ((op & 7) << 2), vr)
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()
AN158:
  Goto IllegalOp
M157:
