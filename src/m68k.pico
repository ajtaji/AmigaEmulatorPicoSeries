  Goto Ctl(op & 63)
C135:
  vs = ea
  ea = Reg(15) - 4
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    PokeU(u, vs >> 16)
    PokeU(u + 2, vs)
  Else
    AeAddr = ea
    M68kWr32(ea, vs)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  Reg(15) = ea
  CLeft = CLeft - (EaCtlCyc(64 + (op & 63)))
  PIP = PIP + xo
  NextOp()

ExtWMovemW:
