NBCD:
  op = PeekU(PIP)
  xo = 2
  If (op & $38) <> 0
  Goto M132
  EndIf
  vs = PeekA(@Reg(0) + ((op & 7) << 2))
  vd = 0
  x = (vd & 15) - (vs & 15) - ((FX >> 31) & 1)
  y = (vd & $F0) - (vs & $F0)
  vr = x + y
  u = vr
  If x & $F0
    vr = vr - 6
    t = Bool(((vd - vs - 6 - ((FX >> 31) & 1)) & $300) > $FF)
  Else
    t = Bool(((vd - vs - ((FX >> 31) & 1)) & $300) > $FF)
  EndIf
  If ((vd - vs - t) & $100) > $FF
    vr = vr - $60
  EndIf
  FX = t << 31
  FC = FX
  FV = ((u & ~vr) & $80) << 24
  FN = (vr & $80) << 24
  FZ = FZ | (vr & $FF)
  PokeA(@Reg(0) + ((op & 7) << 2), vr)
  CLeft = CLeft - 6
  PIP = PIP + xo
  NextOp()
