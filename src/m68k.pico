; ------------------------------------------------------------ the interpreter
; M68kRun(n): execute until at least n clock cycles are spent. Returns the
; cycles used; returns early when the CPU stops (STOP) or halts.
Macro NextOp()
  CompilerIf #M68K_ASM_TAIL = 1
    ASM Uses CLeft, PIP, PEnd
      cmp r6, #0
      ble __ul_m68krun_done
      cmp r4, r11
      bhs __ul_m68krun_resync
      ldrh r0, [r4]
      lsrs r0, r0, #6
      lsls r0, r0, #2
      ldr r1, =global_dispatch
      ldr r1, [r1, r0]
      bx r1
    EndASM
  CompilerElse
    If CLeft <= 0
      Goto Done
    EndIf
    If PIP >= PEnd
      Goto Resync
    EndIf
    Goto Dispatch(PeekU(PIP) >> 6)
  CompilerEndIf
EndMacro

ProcedureRAM.i M68kRun(n.i)
  Protected op.i, xo.i, ea.i, vs.i, vd.i, vr.i, t.i, u.i, x.i, y.i, rg.i
  If Ready = 0
    M68kInitCyc()
    InitDispatch()
    Ready = 1
  EndIf
  If n <= 0
    ProcedureReturn 0
  EndIf
  Budget = n
  CLeft = n
  Goto Resync

Resync:
  If Halted
    CLeft = 0
  Goto Done
  EndIf
  If TracePend Or Stopped Or IplLine > ((SrHi >> 8) & 7) Or (SrHi & $8000)
    If M68kEvents() = 0
      If CLeft > 0
        CLeft = 0
      EndIf
  Goto Done
    EndIf
    If Halted
  Goto Done
    EndIf
  EndIf
  If CLeft <= 0
  Goto Done
  EndIf
  M68kRemap()
  If SrHi & $8000
    TracePend = 1
    PEnd = 0
  EndIf
  Goto Dispatch(PeekU(PIP) >> 6)

