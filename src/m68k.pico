MoveToSR:
  op = PeekU(PIP)
  xo = 2
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  If (op & $38) = 0
    vs = PeekU(@Reg(0) + ((op & 7) << 2))
    Goto S131
  EndIf
  If (op & $38) = 8
