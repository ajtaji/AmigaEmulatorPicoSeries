    AeCode = 0
  Goto AddrErr
  EndIf
  For rg = 15 To 0 Step -1
    If vs & (1 << (15 - rg))
      ea = ea - 2
      vr = Reg(rg)
      If rg = 8 + (op & 7)
        vr = y
