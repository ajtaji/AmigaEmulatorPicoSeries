PRE140:
  ea = Reg(8 + (op & 7))
  y = ea
  If (ea & 1) And vs <> 0
    AeAddr = ea - 2
    AeBack = 4 - EaCtlCyc(256 + (op & 63))
    AeCode = 0
  Goto AddrErr
  EndIf
  For rg = 15 To 0 Step -1
    If vs & (1 << (15 - rg))
      ea = ea - 4
      vr = Reg(rg)
      If rg = 8 + (op & 7)
        vr = y
      EndIf
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    PokeU(u, vr >> 16)
    PokeU(u + 2, vr)
  Else
    AeAddr = ea
    M68kWr32(ea, vr)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - 8
    EndIf
  Next
  Reg(8 + (op & 7)) = ea
  CLeft = CLeft - (EaCtlCyc(256 + (op & 63)))
  PIP = PIP + xo
  NextOp()

TSTB:
  op = PeekU(PIP)
  xo = 2
  If (op & 63) >= $3A
  Goto IllegalOp
  EndIf
  If (op & $38) = 0
    vs = PeekA(@Reg(0) + ((op & 7) << 2))
    Goto S142
  EndIf
  If (op & $38) = 8
    Goto IllegalOp
  EndIf
  EaRet = ?S142
  Goto SrcB(op & 63)
S142:
  FZ = (vs) << 24
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()

TSTW:
  op = PeekU(PIP)
  xo = 2
  If (op & 63) >= $3A
  Goto IllegalOp
  EndIf
  If (op & $38) = 0
    vs = PeekU(@Reg(0) + ((op & 7) << 2))
    Goto S143
  EndIf
  If (op & $38) = 8
    Goto IllegalOp
  EndIf
  EaRet = ?S143
  Goto SrcW(op & 63)
S143:
  FZ = (vs) << 16
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()

TSTL:
  op = PeekU(PIP)
  xo = 2
  If (op & 63) >= $3A
  Goto IllegalOp
  EndIf
  If (op & $38) = 0
    vs = Reg(op & 7)
    Goto S144
  EndIf
  If (op & $38) = 8
    Goto IllegalOp
  EndIf
  EaRet = ?S144
  Goto SrcL(op & 63)
S144:
  FZ = vs
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()

TAS:
  op = PeekU(PIP)
  xo = 2
  If op = $4AFC
  Goto IllegalOp
  EndIf
  If (op & $38) <> 0
  Goto M145
  EndIf
  vd = PeekA(@Reg(0) + ((op & 7) << 2))
  FZ = (vd) << 24
  FN = FZ
  FV = 0
  FC = 0
  PokeA(@Reg(0) + ((op & 7) << 2), vd | $80)
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()
M145:
  EaRet = ?A146
  Goto AltB(op & 63)
A146:
  t = PageR((ea >> 12) & $FFF)
  If t <> 0
    vd = PeekA(t + ((ea & $FFFFFF) ! 1))
  Else
    vd = M68kRd8(ea)
  EndIf
  FZ = (vd) << 24
  FN = FZ
  FV = 0
  FC = 0
  t = PageW((ea >> 12) & $FFF)
  If t <> 0
    PokeA(t + ((ea & $FFFFFF) ! 1), vd | $80)
  Else
    M68kWr8(ea, vd | $80)
  EndIf
  CLeft = CLeft - 10
  PIP = PIP + xo
  NextOp()

MovemMW:
  op = PeekU(PIP)
  xo = 2
  vs = PeekU(PIP + 2)
  xo = 4
  If (op & $38) = $18
  Goto POST147
  EndIf
  If (op & $38) = $20
  Goto IllegalOp
  EndIf
  EaRet = ?C148
  Goto Ctl(op & 63)
C148:
LOOP149:
  If (ea & 1) And vs <> 0
    AeAddr = ea
    AeBack = 8 - EaCtlCyc(320 + (op & 63))
    AeCode = $10
    If (op & $38) = $18
      Reg(8 + (op & 7)) = ea + 2
    EndIf
  Goto AddrErr
  EndIf
  For rg = 0 To 15
    If vs & (1 << rg)
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vr = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vr = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
      Reg(rg) = ((vr) << 16) >> 16
      ea = ea + 2
  CLeft = CLeft - 4
    EndIf
  Next
  If (op & $38) = $18
    Reg(8 + (op & 7)) = ea
  EndIf
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vr = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vr = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - (EaCtlCyc(320 + (op & 63)))
  PIP = PIP + xo
  NextOp()
POST147:
  ea = Reg(8 + (op & 7))
  Goto LOOP149

MovemML:
  op = PeekU(PIP)
  xo = 2
  vs = PeekU(PIP + 2)
  xo = 4
  If (op & $38) = $18
  Goto POST150
  EndIf
  If (op & $38) = $20
  Goto IllegalOp
  EndIf
  EaRet = ?C151
  Goto Ctl(op & 63)
C151:
LOOP152:
  If (ea & 1) And vs <> 0
    AeAddr = ea
    AeBack = 8 - EaCtlCyc(320 + (op & 63))
    AeCode = $10
    If (op & $38) = $18
      Reg(8 + (op & 7)) = ea + 2
    EndIf
  Goto AddrErr
  EndIf
  For rg = 0 To 15
    If vs & (1 << rg)
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    vr = (PeekU(u) << 16) | PeekU(u + 2)
  Else
    AeAddr = ea
    vr = M68kRd32(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
      Reg(rg) = vr
      ea = ea + 4
  CLeft = CLeft - 8
    EndIf
  Next
  If (op & $38) = $18
    Reg(8 + (op & 7)) = ea
  EndIf
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vr = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vr = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  CLeft = CLeft - (EaCtlCyc(320 + (op & 63)))
  PIP = PIP + xo
  NextOp()
POST150:
  ea = Reg(8 + (op & 7))
  Goto LOOP152

Misc4E:
  op = PeekU(PIP)
  xo = 2
  x = (op >> 3) & 7
  If x = 0
  Goto OpTRAP
  EndIf
  If x = 1
  Goto OpTRAP
  EndIf
  If x = 2
  Goto OpLINK
  EndIf
  If x = 3
  Goto OpUNLK
  EndIf
  If x = 4
  Goto OpMoveToUsp
  EndIf
  If x = 5
  Goto OpMoveFromUsp
  EndIf
  If op = $4E70
  Goto OpRESET
  EndIf
  If op = $4E71
  Goto OpNOP
  EndIf
  If op = $4E72
  Goto OpSTOP
  EndIf
  If op = $4E73
  Goto OpRTE
  EndIf
  If op = $4E75
  Goto OpRTS
  EndIf
  If op = $4E76
  Goto OpTRAPV
  EndIf
  If op = $4E77
  Goto OpRTR
  EndIf
  Goto IllegalOp
OpTRAP:
  ExcPc = (PIP - PBase) + 2
  ExcVec = 32 + (op & 15)
  ExcCyc = 34
  Goto TakeExc
OpLINK:
  rg = 8 + (op & 7)
  vs = Reg(rg)
  ea = Reg(15) - 4
  If rg = 15
    vs = ea
  EndIf
  t = PageW((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    PokeU(u, vs >> 16)
    PokeU(u + 2, vs)
  Else
    AeAddr = ea
    M68kWr32(ea, vs)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  Reg(15) = ea
  Reg(rg) = ea
  Reg(15) = Reg(15) + PeekW(PIP + 2)
  xo = 4
  CLeft = CLeft - 16
  PIP = PIP + xo
  NextOp()
OpUNLK:
  ea = Reg(8 + (op & 7))
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    vr = (PeekU(u) << 16) | PeekU(u + 2)
  Else
    AeAddr = ea
    vr = M68kRd32(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  Reg(15) = ea + 4
  Reg(8 + (op & 7)) = vr
  CLeft = CLeft - 12
  PIP = PIP + xo
  NextOp()
OpMoveToUsp:
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  USP = Reg(8 + (op & 7))
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()
OpMoveFromUsp:
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  Reg(8 + (op & 7)) = USP
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()
OpRESET:
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  M68kResetHook()
  CLeft = CLeft - 132
  PIP = PIP + xo
  NextOp()
OpNOP:
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()
OpSTOP:
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  M68kSetSR(PeekU(PIP + 2))
  Stopped = 1
  PIP = PIP + 4
  CLeft = CLeft - 4
  Goto Resync
OpRTE:
  If (SrHi & $2000) = 0
  Goto PrivViol
  EndIf
  ea = Reg(15)
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vs = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vs = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  ea = ea + 2
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    vd = (PeekU(u) << 16) | PeekU(u + 2)
  Else
    AeAddr = ea
    vd = M68kRd32(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  Reg(15) = ea + 4
  M68kSetSR(vs)
  PBase = 0
  PIP = vd
  PEnd = 0
  If vd & 1
    AeAddr = vd
    AePc = vd - 4
    AeBack = -12
  Goto JumpErr
  EndIf
  CLeft = CLeft - 20
  Goto Resync
OpRTS:
  ea = Reg(15)
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    vd = (PeekU(u) << 16) | PeekU(u + 2)
  Else
    AeAddr = ea
    vd = M68kRd32(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  Reg(15) = ea + 4
  vd = vd
  If vd & 1
    AeAddr = vd
    AePc = vd - 4
    AeBack = -8
  Goto JumpErr
  EndIf
  PIP = PBase + vd
  If PIP < PStart
    PEnd = 0
  EndIf
  CLeft = CLeft - 16
  NextOp()
OpTRAPV:
  If FV < 0
  ExcPc = (PIP - PBase) + 2
  ExcVec = 7
  ExcCyc = 34
  Goto TakeExc
  EndIf
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()
OpRTR:
  ea = Reg(15)
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0
    vs = PeekU(t + (ea & $FFFFFF))
  Else
    AeAddr = ea
    vs = M68kRd16(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  ea = ea + 2
  t = PageR((ea >> 12) & $FFF)
  If t <> 0 And (ea & 1) = 0 And (ea & $FFE) <> $FFE
    u = t + (ea & $FFFFFF)
    vd = (PeekU(u) << 16) | PeekU(u + 2)
  Else
    AeAddr = ea
    vd = M68kRd32(ea)
    If AErr <> 0
      Goto AddrErr
    EndIf
  EndIf
  Reg(15) = ea + 4
  M68kSetCCR(vs)
  vd = vd
  If vd & 1
    AeAddr = vd
    AePc = vd - 4
    AeBack = -12
  Goto JumpErr
  EndIf
  PIP = PBase + vd
  If PIP < PStart
    PEnd = 0
  EndIf
  CLeft = CLeft - 20
  NextOp()

JSR:
  op = PeekU(PIP)
  xo = 2
  EaRet = ?C153
  Goto Ctl(op & 63)
C153:
  vd = ea
  If vd & 1
    AeAddr = vd
    AePc = vd - 4
    AeBack = 16 - (EaCtlCyc(192 + (op & 63)))
  Goto JumpErr
