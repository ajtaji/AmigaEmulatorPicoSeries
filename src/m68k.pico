ORBEaDn:
  op = PeekU(PIP)
  xo = 2
  If (op & $38) = 0
    vs = PeekA(@Reg(0) + ((op & 7) << 2))
    Goto S223
  EndIf
  If (op & $38) = 8
    Goto IllegalOp
  EndIf
  EaRet = ?S223
  Goto SrcB(op & 63)
S223:
  vd = PeekA(@Reg(0) + (((op >> 9) & 7) << 2))
  vr = vd | vs
  FZ = (vr) << 24
  FN = FZ
  FV = 0
  FC = 0
  PokeA(@Reg(0) + (((op >> 9) & 7) << 2), vr)
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()

ORBDnEa:
