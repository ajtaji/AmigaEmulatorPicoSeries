MoveB0:
  op = PeekU(PIP)
  xo = 2
  If (op & $38) = 0
    vs = PeekA(@Reg(0) + ((op & 7) << 2))
    Goto S1
  EndIf
  EaRet = ?S1
  Goto SrcB(op & 63)
S1:
  PokeA(@Reg(0) + (((op >> 9) & 7) << 2), vs)
  FZ = (vs) << 24
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 4
  PIP = PIP + xo
  NextOp()

MoveB2:
  op = PeekU(PIP)
  xo = 2
  If (op & $38) = 0
    vs = PeekA(@Reg(0) + ((op & 7) << 2))
    Goto S2
  EndIf
  EaRet = ?S2
  Goto SrcB(op & 63)
S2:
  rg = 8 + ((op >> 9) & 7)
  ea = Reg(rg)
  t = PageW((ea >> 12) & $FFF)
  If t <> 0
    PokeA(t + ((ea & $FFFFFF) ! 1), vs)
  Else
    M68kWr8(ea, vs)
  EndIf
  FZ = (vs) << 24
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 8
  PIP = PIP + xo
  NextOp()
ME3:
  AePc = PIP - PBase + xo - 2
  CLeft = CLeft - 4
  FN = ((vs >> 15) & 1) << 31
  FZ = vs & $FFFF
  FV = 0
  FC = 0
  Goto AddrErrP

MoveB3:
  op = PeekU(PIP)
  xo = 2
  If (op & $38) = 0
    vs = PeekA(@Reg(0) + ((op & 7) << 2))
    Goto S4
  EndIf
  EaRet = ?S4
  Goto SrcB(op & 63)
S4:
  rg = 8 + ((op >> 9) & 7)
  ea = Reg(rg)
  t = PageW((ea >> 12) & $FFF)
  If t <> 0
