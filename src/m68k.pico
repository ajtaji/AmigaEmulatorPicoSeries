    M68kWr32(ea, vs)
    If AErr <> 0
      Goto ME47
    EndIf
  EndIf
  FZ = vs
  FN = FZ
  FV = 0
  FC = 0
  CLeft = CLeft - 20
  PIP = PIP + xo
  NextOp()
ME47:
  AePc = PIP - PBase + xo - 2
  If (op & $38) >= $10 And (op & 63) <> $3C
  CLeft = CLeft - 12
  Else
  CLeft = CLeft - 16
  EndIf
  If (op & $38) >= $10 And (op & 63) <> $3C
