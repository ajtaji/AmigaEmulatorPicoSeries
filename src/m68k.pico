Macro InitDispatch()
  For InitIndex = 839 To 895 Step 8
    Dispatch(InitIndex) = ?ADDAL
  Next
  For InitIndex = 835 To 891 Step 8
    Dispatch(InitIndex) = ?ADDAW
  Next
  For InitIndex = 836 To 892 Step 8
    Dispatch(InitIndex) = ?ADDBDnEa
  Next
  For InitIndex = 832 To 888 Step 8
    Dispatch(InitIndex) = ?ADDBEaDn
  Next
  Dispatch(24) = ?ADDIB
  Dispatch(26) = ?ADDIL
  Dispatch(25) = ?ADDIW
  For InitIndex = 838 To 894 Step 8
    Dispatch(InitIndex) = ?ADDLDnEa
