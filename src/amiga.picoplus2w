; The Amiga 500 on the Pimoroni Pico Plus 2 W (RP2350B, 8 MB PSRAM on GPIO47),
; with Paula on a Bluetooth speaker (src/audio_bt.pmi).
; This published wrapper has no speaker address: the machine runs silent and says
; so. For sound, copy it OUTSIDE the repository, put the speaker's address in
; Speaker (as a phone shows it: AA:BB:CC:DD:EE:FF -> Data.a $AA,$BB,$CC,$DD,$EE,$FF),
; include amiga_pico.pmi by its absolute path, and build the copy
; (tools/pico_machine.ps1 -Source <copy>).
EnableRunFromRAM
#CLOCK_KHZ = 150000
#M68K_ASM_TAIL = 1
#AM_BLIT_ASM = 1               ; the Thumb blitter, copper and Paula (src/*_fast.pmi)
#AM_COPPER_ASM = 1
#AM_AUDIO_ASM = 1
#AMIGA_PTRACE = 0             ; 1: the instruction trace ('j'), with an M68K_PTRACE=1 core
#AMIGA_NTSC = 1              ; 1: the US A500 (60 Hz, 262/263 lines); 0: PAL (50 Hz, 312/313). 'v' switches
#AM_PROFILE = 0                ; 1: the time profile ('p'), see src/amiga_profile.feather2350
#CHIP_SRAM_KB = 0              ; the low chip RAM in SRAM (the rest in PSRAM)
#AMIGA_AUDIO = 1
XIncludeFile "RP2350/Lib/multicore_smp.pico2"
XIncludeFile "RP2350/Lib/cyw43_nvram.pico2"
XIncludeFile "RP2350/Lib/bits.pico2"
XIncludeFile "RP2350/Lib/clocks.pico2"
XIncludeFile "RP2350/Lib/timer.pico2"
XIncludeFile "RP2350/Lib/uart.pico2"
XIncludeFile "RP2350/Lib/usb_serial.pico2"
XIncludeFile "RP2350/Lib/safety.pico2"
XIncludeFile "RP2350/Lib/wiring.pico2"
XIncludeFile "RP2350/Lib/string_out.pico2"
XIncludeFile "RP2350/Lib/flashid.pico2"
XIncludeFile "RP2350/Lib/flash.pico2"
XIncludeFile "RP2350/Lib/psram.pico2"
XIncludeFile "RP2350/Lib/cyw43.pico2"
XIncludeFile "RP2350/Lib/cyw43_btfw.pico2"
XIncludeFile "RP2350/Lib/bluetooth.pico2"
XIncludeFile "Shared/Bluetooth/sbc.pmi"
XIncludeFile "Shared/Bluetooth/bt_audio.pmi"
#KICK_OFFSET = $800000        ; above the PDP-11 packs and store (up to $7FFFFF) and the NES store
#DF0_OFFSET = $880000
#EXT_OFFSET = $980000        ; an extended ROM (AROS), 512 KB
XIncludeFile "amiga_pico.pmi"
DataSection
Speaker:
  Data.a $00, $00, $00, $00, $00, $00
EndDataSection
