; Paula's per-line record in Thumb-2 assembly (RP2350): what amiga/paula.pmi's
; AudioLine does for the four channels when #AM_AUDIO_ASM = 1 - the volumes, each
; channel's output at the line's start, and every byte that starts in the line,
; with its colour clock. It steps the channels by the same clocks and calls the
; same AudioNextByte at the same points, so the bytes fetched, the interrupts
; raised and the record written are the same - proven by Paula's ring and the
; demo's chip RAM matching the PC. Core 1 mixes the record (src/amiga_pico.pmi).
;
; #AM_CCK_LINE (227) is written into the assembly below as a number, and the
; Cust() offsets of AUD0PER ($A6) and AUD0VOL ($A8) as bytes: 166 and 168.
; AudK, longs (offsets in bytes): 0 the channel, 4 its period, 8 the clock of its
; next byte, 12 the changes so far, 16 the address of the channel's part of the
; record, 20 the address of the record.

Global Dim AudK.l(8)

Procedure AudioRecAsm()
  ASM
    ldr r3, =global_audk
    movs r0, #0
    str r0, [r3, #0]
  arf_ch:
    ldr r3, =global_audk
    ldr r0, [r3, #0]
    ; the volume: AUDxVOL & 127, at most 64, into word 1 + c of the record
    lsls r1, r0, #4
    ldr r2, =global_cust
    adds r2, r2, r1
    ldrh r1, [r2, #168]
    and r1, r1, #127
    cmp r1, #64
    ble arf_vol
    movs r1, #64
  arf_vol:
    ldr r5, [r3, #20]
    add r5, r5, r0, lsl #2
    str r1, [r5, #4]
    ; the channel's part: the record + (5 + c * 6) * 4
    ldr r5, [r3, #20]
    adds r5, #20
    movs r1, #24
    mul r1, r0, r1
    adds r5, r5, r1
    str r5, [r3, #16]
    ; its output at the line's start, no changes yet
    ldr r2, =global_audout
    ldr r1, [r2, r0, lsl #2]
    str r1, [r5, #0]
    movs r1, #0
    str r1, [r3, #12]
    ldr r2, =global_audon
    ldr r1, [r2, r0, lsl #2]
    ldr r2, =global_audcpu
    ldr r2, [r2, r0, lsl #2]
    orrs r1, r2
    beq arf_done
    ; the period: AUDxPER, at least 124
    lsls r1, r0, #4
    ldr r2, =global_cust
    adds r2, r2, r1
    ldrh r1, [r2, #166]
    cmp r1, #124
    bge arf_per
    movs r1, #124
  arf_per:
    str r1, [r3, #4]
    ldr r2, =global_audcnt
    ldr r1, [r2, r0, lsl #2]
    str r1, [r3, #8]
  arf_t:
    ; the bytes that start in this line: at clocks AudCnt, + per, ... up to 227
    ldr r3, =global_audk
    ldr r1, [r3, #8]
    cmp r1, #227
    bgt arf_end
    ; the high byte of the word already fetched: here; the low byte (the next
    ; fetch, the interrupt) in AudioNextByte
    ldr r0, [r3, #0]
    ldr r2, =global_audhalf
    ldr r5, [r2, r0, lsl #2]
    cmp r5, #0
    bne arf_low
    movs r5, #1
    str r5, [r2, r0, lsl #2]
    ldr r2, =global_auddat
    ldr r5, [r2, r0, lsl #2]
    lsrs r5, r5, #8
    sxtb r5, r5
    ldr r2, =global_audout
    str r5, [r2, r0, lsl #2]
    b arf_put
  arf_low:
    bl audionextbyte
  arf_put:
    ; the change: (its clock, the output), then the next byte's clock
    ldr r3, =global_audk
    ldr r0, [r3, #0]
    ldr r5, [r3, #16]
    ldr r1, [r3, #12]
    add r5, r5, r1, lsl #3
    ldr r2, [r3, #8]
    str r2, [r5, #8]
    ldr r2, =global_audout
    ldr r2, [r2, r0, lsl #2]
    str r2, [r5, #12]
    adds r1, #1
    str r1, [r3, #12]
    ldr r2, [r3, #8]
    ldr r1, [r3, #4]
    adds r2, r2, r1
    str r2, [r3, #8]
    b arf_t
  arf_end:
    ; AudCnt = the clock past the line's end
    subs r1, #227
    ldr r0, [r3, #0]
    ldr r2, =global_audcnt
    str r1, [r2, r0, lsl #2]
  arf_done:
    ldr r3, =global_audk
    ldr r5, [r3, #16]
    ldr r1, [r3, #12]
    str r1, [r5, #4]
    ldr r0, [r3, #0]
    adds r0, #1
    str r0, [r3, #0]
    cmp r0, #4
    blt arf_ch
  EndASM
EndProcedure

; The four channels' part of record b (AudRec(b) = n already written).
Procedure AudioRecFast(b.i)
  AudK(5) = @AudRec(b)
  AudioRecAsm()
EndProcedure
