  If Ready = 0
    M68kInitCyc()
    Ready = 1
  EndIf
  If n <= 0
    ProcedureReturn 0
  EndIf
  Budget = n
  CLeft = n
  Goto Resync

Resync:
  If Halted
    CLeft = 0
  Goto Done
  EndIf
  If TracePend Or Stopped Or IplLine > ((SrHi >> 8) & 7) Or (SrHi & $8000)
    If M68kEvents() = 0
      If CLeft > 0
        CLeft = 0
      EndIf
  Goto Done
    EndIf
    If Halted
  Goto Done
    EndIf
  EndIf
  If CLeft <= 0
  Goto Done
  EndIf
  M68kRemap()
  If SrHi & $8000
    TracePend = 1
    PEnd = 0
  EndIf
