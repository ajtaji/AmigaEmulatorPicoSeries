; Generated by tools/gen_m68k.py. Edit the generator, then regenerate.
; Motorola 68000 interpreter core, PureBasic (C back end, x64), for the desktop program.
; The same handlers as the Pico cores, with 64-bit flag shifts; the computed
; jumps are C labels-as-values (gcc && and goto *).
; Target: desktop. See README.md for the API, memory map and limits.
;
; Configuration, declared by the including program before XIncludeFile:
;   #M68K_ASM_TAIL 1 = inline-assembly dispatch tail, 0 = PureMetal Goto (Pico only)
;
; The including program defines these procedures (any order):
;   M68kHookRd8.i(a.i) / M68kHookRd16.i(a.i)       read from a hook page (a: 24-bit, even for 16)
;   M68kHookWr8(a.i, v.i) / M68kHookWr16(a.i, v.i)  write to a hook page
;   M68kResetHook()                                the RESET instruction
EnableExplicit

Declare.i M68kHookRd8(a.i)
Declare.i M68kHookRd16(a.i)
Declare M68kHookWr8(a.i, v.i)
Declare M68kHookWr16(a.i, v.i)
Declare M68kResetHook()
#M68K_ASM_TAIL = 0

#M68K_PAGES = 4096                 ; 16 MB in 4 KB pages
#M68K_RAM = 0                      ; page kinds
#M68K_ROM = 1
#M68K_HOOK = 2

Global Dim Reg.l(16)               ; D0-D7 then A0-A7 (A7 = the active stack pointer)
Global Dim PageR.i(#M68K_PAGES)    ; host address minus guest page base, 0 = slow path
Global Dim PageW.i(#M68K_PAGES)
Global Dim PageK.a(#M68K_PAGES)
Global Dim Buf.u(8)                ; an instruction fetched across a page end
Global Dim EaCtlCyc.a(384)         ; LEA/PEA/JMP/JSR/MOVEM cycles: kind * 64 + EA field
Global PIP.i, PEnd.i, CLeft.i, FZ.i, FN.i, FC.i, FV.i, FX.i
Global PBase.i, PStart.i, Budget.i, SrHi.i, USP.i, SSP.i
Global IplLine.i, Stopped.i, Halted.i, TracePend.i, Ready.i, InitIndex.i
Global AErr.i, AeAddr.i, AePc.i, AeCode.i, AeBack.i, ExcPc.i, ExcVec.i, ExcCyc.i
Global M68kFetching.i, M68kCycles.i, M68kLastVec.i, M68kExceptions.i   ; the last exception taken, and how many

; ------------------------------------------------------------ slow memory paths
; Any address, any page kind. A word or long at an odd address is an address
; error: AErr = 1 and the caller raises it. Hook pages call the machine.
Procedure.i M68kRd8(a.i)
  Protected p.i
  p = (a >> 12) & $FFF
  If PageK(p) = #M68K_HOOK
    ProcedureReturn M68kHookRd8(a & $FFFFFF) & 255
  EndIf
  ProcedureReturn PeekA(PageR(p) + ((a & $FFFFFF) ! 1))
EndProcedure

Procedure.i M68kRd16(a.i)
  Protected p.i
  If a & 1
    AErr = 1
    AeBack = 4
    AeCode = $10
    ProcedureReturn 0
  EndIf
  p = (a >> 12) & $FFF
  If PageK(p) = #M68K_HOOK
    ProcedureReturn M68kHookRd16(a & $FFFFFF) & $FFFF
  EndIf
  ProcedureReturn PeekU(PageR(p) + (a & $FFFFFF))
EndProcedure

Procedure.i M68kRd32(a.i)
  Protected h.i
  If a & 1
    AErr = 1
    AeBack = 8
    AeCode = $10
    ProcedureReturn 0
  EndIf
  h = M68kRd16(a)
  ProcedureReturn (h << 16) | M68kRd16(a + 2)
EndProcedure

Procedure M68kWr8(a.i, v.i)
  Protected p.i
  p = (a >> 12) & $FFF
  If PageK(p) = #M68K_RAM
    PokeA(PageW(p) + ((a & $FFFFFF) ! 1), v)
  Else
    M68kHookWr8(a & $FFFFFF, v & 255)
  EndIf
EndProcedure

Procedure M68kWr16(a.i, v.i)
  Protected p.i
  If a & 1
    AErr = 1
    AeBack = 4
    AeCode = 0
    ProcedureReturn
  EndIf
  p = (a >> 12) & $FFF
  If PageK(p) = #M68K_RAM
    PokeU(PageW(p) + (a & $FFFFFF), v)
  Else
    M68kHookWr16(a & $FFFFFF, v & $FFFF)
  EndIf
EndProcedure

Procedure M68kWr32(a.i, v.i)
  If a & 1
    AErr = 1
    AeBack = 8
    AeCode = 0
    ProcedureReturn
  EndIf
  M68kWr16(a, v >> 16)
  M68kWr16(a + 2, v)
EndProcedure

; ------------------------------------------------------------ status register
Procedure.i M68kGetSR()
  Protected f.i
  f = SrHi
  If FX < 0
    f = f | 16
  EndIf
  If FN < 0
    f = f | 8
  EndIf
  If FZ = 0
    f = f | 4
  EndIf
  If FV < 0
    f = f | 2
  EndIf
  If FC < 0
    f = f | 1
  EndIf
  ProcedureReturn f
EndProcedure

Procedure M68kSetCCR(v.i)
  FX = ((v >> 4) & 1) << 63
  FN = ((v >> 3) & 1) << 63
  FZ = ((v >> 2) & 1) ! 1
  FV = ((v >> 1) & 1) << 63
  FC = (v & 1) << 63
EndProcedure

; Supervisor bit: A7 is the SSP in supervisor mode and the USP in user mode.
Procedure M68kSetSuper(s.i)
  If s
    If (SrHi & $2000) = 0
      USP = Reg(15)
      Reg(15) = SSP
      SrHi = SrHi | $2000
    EndIf
  Else
    If SrHi & $2000
      SSP = Reg(15)
      Reg(15) = USP
      SrHi = SrHi & $A700 & ~$2000
    EndIf
  EndIf
EndProcedure

; Load the whole SR. The interrupt mask, trace and supervisor bits are
; checked again at the next instruction boundary.
Procedure M68kSetSR(v.i)
  M68kSetCCR(v)
  M68kSetSuper(v & $2000)
  SrHi = v & $A700
  PEnd = 0
EndProcedure

; ------------------------------------------------------------ registers
Procedure.i M68kGetPC()
  ProcedureReturn ((PIP - PBase) & $FFFFFFFF)
EndProcedure

Procedure M68kSetPC(pc.i)
  PBase = 0
  PIP = ((pc) & $FFFFFFFF)
  PEnd = 0
EndProcedure

Procedure.i M68kGetUSP()
  If SrHi & $2000
    ProcedureReturn USP
  EndIf
  ProcedureReturn Reg(15)
EndProcedure

Procedure.i M68kGetSSP()
  If SrHi & $2000
    ProcedureReturn Reg(15)
  EndIf
  ProcedureReturn SSP
EndProcedure

Procedure M68kSetUSP(v.i)
  If SrHi & $2000
    USP = v
  Else
    Reg(15) = v
  EndIf
EndProcedure

Procedure M68kSetSSP(v.i)
  If SrHi & $2000
    Reg(15) = v
  Else
    SSP = v
  EndIf
EndProcedure

; ------------------------------------------------------------ memory map
; addr and bytes are multiples of 4096 inside the 16 MB bus. The host memory
; holds the guest's 16-bit words in host byte order (see README.md).
Procedure M68kMapRam(addr.i, bytes.i, host.i)
  Protected p.i
  For p = (addr >> 12) & $FFF To ((addr + bytes - 1) >> 12) & $FFF
    PageK(p) = #M68K_RAM
    PageR(p) = host - addr
    PageW(p) = PageR(p)
  Next
  PEnd = 0
EndProcedure

Procedure M68kMapRom(addr.i, bytes.i, host.i)
  Protected p.i
  For p = (addr >> 12) & $FFF To ((addr + bytes - 1) >> 12) & $FFF
    PageK(p) = #M68K_ROM
    PageR(p) = host - addr
    PageW(p) = 0
  Next
  PEnd = 0
EndProcedure

Procedure M68kMapHook(addr.i, bytes.i)
  Protected p.i
  For p = (addr >> 12) & $FFF To ((addr + bytes - 1) >> 12) & $FFF
    PageK(p) = #M68K_HOOK
    PageR(p) = 0
    PageW(p) = 0
  Next
  PEnd = 0
EndProcedure

; ------------------------------------------------------------ exceptions
; The 68000's six-byte frame: SR, then the PC (written PC low, SR, PC high).
Procedure M68kPushFrame(sr.i, pc.i)
  Protected sp.i
  sp = Reg(15) - 6
  Reg(15) = sp
  If sp & 1
    Halted = 1
    ProcedureReturn
  EndIf
  M68kWr16(sp + 4, pc)
  M68kWr16(sp, sr)
  M68kWr16(sp + 2, pc >> 16)
EndProcedure

; Group 1 and 2 exceptions (TRAP, CHK, divide by zero, illegal, privilege, trace).
; (Every procedure that moves the PC does it itself: PIP is held in a register.)
Procedure M68kException(vec.i, pc.i)
  Protected sr.i
  M68kLastVec = vec
  M68kExceptions = M68kExceptions + 1
  sr = M68kGetSR()
  M68kSetSuper(1)
  SrHi = SrHi & ~$8000
  TracePend = 0
  M68kPushFrame(sr, pc)
  pc = M68kRd32(vec << 2)
  PBase = 0
  PIP = ((pc) & $FFFFFFFF)
  PEnd = 0
EndProcedure

; An interrupt of level lv (autovectored, as on the Amiga).
Procedure M68kInterrupt(lv.i)
  Protected sr.i, pc.i
  M68kLastVec = 24 + lv
  M68kExceptions = M68kExceptions + 1
  sr = M68kGetSR()
  M68kSetSuper(1)
  SrHi = (SrHi & ~$8700) | (lv << 8)
  TracePend = 0
  Stopped = 0
  M68kPushFrame(sr, ((PIP - PBase) & $FFFFFFFF))
  pc = M68kRd32((24 + lv) << 2)
  PBase = 0
  PIP = ((pc) & $FFFFFFFF)
  PEnd = 0
  CLeft = CLeft - 44
EndProcedure

; Address error: the 14-byte group 0 frame. code: the IR in bits 16-31, the
; status word (IR bits 5-15, R/W, I/N, function code) in bits 0-15.
Procedure M68kAddressError(addr.i, pc.i, code.i)
  Protected sr.i, sp.i
  M68kLastVec = 3
  M68kExceptions = M68kExceptions + 1
  AErr = 0
  sr = M68kGetSR()
  M68kSetSuper(1)
  SrHi = SrHi & ~$8000
  TracePend = 0
  sp = Reg(15) - 14
  Reg(15) = sp
  If sp & 1
    Halted = 1
    ProcedureReturn
  EndIf
  M68kWr16(sp + 12, pc)
  M68kWr16(sp + 8, sr)
  M68kWr16(sp + 10, pc >> 16)
  M68kWr16(sp + 6, code >> 16)
  M68kWr16(sp + 4, addr)
  M68kWr16(sp, code)
  M68kWr16(sp + 2, addr >> 16)
  pc = M68kRd32(3 << 2)
  PBase = 0
  PIP = ((pc) & $FFFFFFFF)
  PEnd = 0
EndProcedure

; Power-on reset: supervisor, interrupts masked, SSP and PC from vectors 0 and 1.
Procedure M68kReset()
  Protected pc.i
  SrHi = $2700
  M68kSetCCR(0)
  Reg(15) = M68kRd32(0)
  SSP = Reg(15)
  Stopped = 0
  Halted = 0
  TracePend = 0
  AErr = 0
  pc = M68kRd32(1 << 2)
  PBase = 0
  PIP = ((pc) & $FFFFFFFF)
  PEnd = 0
EndProcedure

; The interrupt priority level the chips present (0 = none, 1-7).
Procedure M68kSetIpl(lv.i)
  IplLine = lv
  PEnd = 0
EndProcedure

; An instruction boundary with something to do: trace, interrupt, STOP.
; Returns 0 when the CPU has nothing to run (stopped or halted).
Procedure.i M68kEvents()
  If TracePend
    TracePend = 0
    M68kException(9, ((PIP - PBase) & $FFFFFFFF))
    CLeft = CLeft - 34
  EndIf
  If IplLine > ((SrHi >> 8) & 7) Or IplLine = 7
    If IplLine > ((SrHi >> 8) & 7)
      M68kInterrupt(IplLine)
    EndIf
  EndIf
  If Stopped Or Halted
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

; Build the fetch window around the guest PC (PIP - PBase).
Procedure M68kRemap()
  Protected pc.i, t.i, i.i
  pc = ((PIP - PBase) & $FFFFFFFF)
  t = PageR((pc >> 12) & $FFF)
  If t <> 0 And (pc & $FFF) < $FF7
    PStart = t + (pc & $FFF000)
    PIP = t + (pc & $FFFFFF)
    PBase = PIP - pc
    PEnd = PStart + $FF8
  Else
    M68kFetching = 1
    For i = 0 To 4
      Buf(i) = M68kRd16(pc + i * 2)
    Next
    M68kFetching = 0
    AErr = 0
    PIP = @Buf(0)
    PBase = PIP - pc
    PStart = PIP
    PEnd = PIP + 1
  EndIf
EndProcedure

; DIVU / DIVS: register rg (0-7) divided by the 16-bit source v. Flags and
; cycles as the 68000 sets them, undefined flags included. Returns 1 for a
; divide by zero (the caller takes the exception).
Procedure.i M68kDivU(rg.i, v.i)
  Protected a.q, q.q, r.q, h.q, i.i, mc.i
  a = Reg(rg) & $FFFFFFFF
  v = v & $FFFF
  If v = 0
    FN = ((a >> 31) & 1) << 63
    FZ = (a >> 16) & $FFFF
    FV = 0
    FC = 0
    ProcedureReturn 1
  EndIf
  If ((a >> 16) & $FFFF) >= v
    FV = 1 << 63
    FN = 1 << 63
    FZ = 1
    FC = 0
    CLeft = CLeft - 10
    ProcedureReturn 0
  EndIf
  q = a / v
  r = a - q * v
  Reg(rg) = (r << 16) | q
  FN = ((q >> 15) & 1) << 63
  FZ = q
  FV = 0
  FC = 0
  mc = 38
  h = v << 16
  For i = 0 To 14
    If a & $80000000
      a = ((a << 1) - h) & $FFFFFFFF
    Else
      a = (a << 1) & $FFFFFFFF
      If a >= h
        a = a - h
        mc = mc + 1
      Else
        mc = mc + 2
      EndIf
    EndIf
  Next
  CLeft = CLeft - mc * 2
  ProcedureReturn 0
EndProcedure

Procedure.i M68kDivS(rg.i, v.i)
  Protected a.q, d.q, q.q, r.q, aq.i, i.i, mc.i
  a = Reg(rg)
  d = (((v) << 48) >> 48)
  If d = 0
    FN = 0
    FZ = 0
    FV = 0
    FC = 0
    ProcedureReturn 1
  EndIf
  mc = 6
  If a < 0
    mc = 7
  EndIf
  q = Abs(a)
  r = Abs(d)
  If (q >> 16) >= r
    FV = 1 << 63
    FN = 1 << 63
    FZ = 1
    FC = 0
    CLeft = CLeft - (mc + 2) * 2
    ProcedureReturn 0
  EndIf
  aq = q / r
  mc = mc + 55
  If d >= 0
    If a < 0
      mc = mc + 1
    Else
      mc = mc - 1
    EndIf
  EndIf
  For i = 0 To 14
    If (aq & $8000) = 0
      mc = mc + 1
    EndIf
    aq = aq << 1
  Next
  CLeft = CLeft - mc * 2
  q = a / d
  r = a - q * d
  If q > 32767 Or q < -32768
    FV = 1 << 63
    FN = 1 << 63
    FZ = 1
    FC = 0
    ProcedureReturn 0
  EndIf
  Reg(rg) = ((r & $FFFF) << 16) | (q & $FFFF)
  FN = ((q >> 15) & 1) << 63
  FZ = q & $FFFF
  FV = 0
  FC = 0
  ProcedureReturn 0
EndProcedure

