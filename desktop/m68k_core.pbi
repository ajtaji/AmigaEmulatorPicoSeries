  rg = 1
  If rg = 0
  Goto Z381
  EndIf
  x = rg
  While x > 16
    x = x - 17
  Wend
  vr = vd
  y = ((FX >> 63) & 1)
  While x > 0
    u = vr & 1
    vr = (vr >> 1) | (y << 15)
    y = u
    x = x - 1
  Wend
