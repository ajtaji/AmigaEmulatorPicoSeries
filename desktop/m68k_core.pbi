IllegalOp:
  op = PeekU(PIP)
  ExcPc = (PIP - PBase)
  ExcVec = 4
  ExcCyc = 34
  Goto TakeExc
LineA:
  ExcPc = (PIP - PBase)
  ExcVec = 10
  ExcCyc = 34
  Goto TakeExc
LineF:
  ExcPc = (PIP - PBase)
  ExcVec = 11
  ExcCyc = 34
  Goto TakeExc
PrivViol:
  ExcPc = (PIP - PBase)
  ExcVec = 8
  ExcCyc = 34
  Goto TakeExc
TakeExc:
  M68kException(ExcVec, ((ExcPc) & $FFFFFFFF))
  CLeft = CLeft - ExcCyc
  Goto Resync
; A data access at AeAddr faulted (AeCode: $10 read, 0 write).
AddrErr:
  AePc = PIP - PBase + xo - 2
AddrErrP:
  If SrHi & $2000
    x = 5
  Else
    x = 1
  EndIf
  M68kAddressError(AeAddr, ((AePc) & $FFFFFFFF), (op << 16) | (op & $FFE0) | AeCode | x)
  CLeft = CLeft - 50 + AeBack
  Goto Resync
; A jump to an odd address: the fetch at AeAddr faults, AePc is pushed.
JumpErr:
  If SrHi & $2000
    x = $1E
  Else
    x = $1A
  EndIf
  M68kAddressError(AeAddr, ((AePc) & $FFFFFFFF), (op << 16) | (op & $FFE0) | x)
  CLeft = CLeft - 50 + AeBack
  Goto Resync

Done:
  M68kCycles = M68kCycles + Budget - CLeft
  ProcedureReturn Budget - CLeft
EndProcedure
