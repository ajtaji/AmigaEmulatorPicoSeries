  rg = 1
  If rg = 0
  Goto Z372
  EndIf
  If rg < 16
    vr = (vd << rg) & $FFFF
    FC = ((vd >> (16 - rg)) & 1) << 63
    x = (((vd) << 48) >> 48) >> (15 - rg)
    If x = 0 Or x = -1
      FV = 0
    Else
      FV = $8000000000000000
    EndIf
  Else
    vr = 0
    If rg = 16
      FC = (vd & 1) << 63
    Else
      FC = 0
    EndIf
    If vd <> 0
      FV = $8000000000000000
    Else
      FV = 0
    EndIf
  EndIf
  FX = FC
